    "test:format": "node --test src/lib/formatRemaining.test.js",
    "test:selectors": "node --test src/store/selectors.test.js",
    "test:evidence": "node --test src/lib/splitEvidence.test.js",
    "test:metrics": "node --test src/lib/metrics.test.js",
    "test:session": "node --test src/lib/session.test.js",
    "test:evaluate": "node --test src/lib/evaluate.test.js",
    "test:groups": "node --test src/lib/groupByUrgency.test.js",
    "test:sidebar": "node --test src/lib/sidebarPref.test.js",
    "test:deadline": "node --test src/lib/deadlinePill.test.js",
