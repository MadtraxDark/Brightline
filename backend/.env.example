# Copy to .env in the repository root. Docker Compose starts local PostgreSQL.
POSTGRES_DB=brightline
POSTGRES_USER=brightline
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433
DATABASE_URL=postgresql://brightline:CHANGE_ME@localhost:5433/brightline
BRIGHTLINE_HTTP_PORT=8080
BRIGHTLINE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini Developer API. Add your own key locally; never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
