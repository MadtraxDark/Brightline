FROM tensorflow/tensorflow:latest

WORKDIR /workspace
COPY train_nih.py /workspace/train_nih.py
RUN pip install --no-cache-dir "psycopg[binary]>=3.2,<4.0"

ENV NIH_DATA_DIR=/data/nih \
    MODEL_OUTPUT_DIR=/output \
    EPOCHS=3 \
    BATCH_SIZE=16 \
    IMAGE_SIZE=224

CMD ["python", "/workspace/train_nih.py"]
