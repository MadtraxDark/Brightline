# Copie para .env na raiz. O Docker Compose cria o PostgreSQL local.
POSTGRES_DB=brightline
POSTGRES_USER=brightline
POSTGRES_PASSWORD=REMOVED_CREDENTIAL
POSTGRES_PORT=5433
DATABASE_URL=postgresql://brightline:REMOVED_CREDENTIAL@localhost:5433/brightline
BRIGHTLINE_HTTP_PORT=8080
BRIGHTLINE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Somente para extração offline de IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
