# Copie para .env na raiz. O backend lê automaticamente este arquivo.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# Compatibilidade: VITE_SUPABASE_URL e VITE_SUPABASE_PUBLISHABLE_KEY também são aceitas.
# Nunca use chave service_role/secret no frontend nem nestas variáveis públicas.
BRIGHTLINE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Somente para extração offline de IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
